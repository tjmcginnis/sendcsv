<% content_for :heading do %>
  <%= @table.name %>
<% end %>

<% unless @table.rows.empty? %>
  <%= render "tables/drawer" %>

  <div class="mt-4 flow-root">
    <div class="-mx-4 -my-2 sm:-mx-6 lg:-mx-8 max-h-[calc(100vh-16rem)] overflow-auto">
      <div class="inline-block min-w-full py-2 align-middle">
        <table class="min-w-full border-separate border-spacing-0">
          <thead>
            <tr>
              <% @table.header.each do |column| %>
                <th scope="col" class="sticky top-0 z-10 border-b border-gray-300 bg-white/75 py-3.5 pr-3 pl-4 text-left text-sm font-semibold text-gray-900 backdrop-blur-sm backdrop-filter sm:pl-6 lg:pl-8 dark:border-white/15 dark:bg-blue-grey-800/75 dark:text-white text-nowrap">
                  <%= sanitize column.to_s %>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @table.rows.each do |row| %>
              <tr>
                <% row.contents.each do |value| %>
                  <td class="border-b border-gray-200 py-4 pr-3 pl-4 text-sm font-medium whitespace-nowrap text-gray-900 sm:pl-6 lg:pl-8 dark:border-white/10 dark:text-white">
                    <%= sanitize value.to_s %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% else %>
  <div class="text-center">
    <%= image_tag "table-cells.svg", alt: "Empty Table", class: "mx-auto size-12" %>
    <h3 class="mt-2 text-sm font-semibold text-gray-900 dark:text-white">This table is empty</h3>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Use this special address to post CSV directly into this table.
    </p>
    <div class="w-1/2 mx-auto mt-6">
      <%= render "tables/copy_url_form" %>
    </div>
  </div>
<% end %>
